{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["node_modules"]
}
