{
  "name": "agent-arche",
  "version": "1.4.0",
  "description": "Selective Claude Code and Codex skills, lean hooks, indexed memory, and optional multi-agent orchestration",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "skills",
    "hooks",
    "memory",
    "orchestration",
    "subagents",
    "shopify",
    "klaviyo",
    "django",
    "commerce"
  ],
  "homepage": "https://github.com/AshenDulsanka/agent-arche#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshenDulsanka/agent-arche.git"
  },
  "bugs": {
    "url": "https://github.com/AshenDulsanka/agent-arche/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-arche": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck",
    "start": "tsx bin/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepack": "npm run check && npm run clean && npm run build:dist"
  },
  "files": [
    "claude/",
    "codex/",
    "context/",
    "skills/",
    "memory/",
    "commerce/",
    "docs/",
    "licenses/",
    "NOTICE.md",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
